# Supabase project (Project settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# 32 random bytes, base64:  openssl rand -base64 32
# Encrypts full Aadhaar numbers. Keep a safe copy: losing it means stored numbers can't be read.
AADHAAR_KEY=
# Optional "are you human" check on logins (Cloudflare Turnstile site key).
# Leave empty to keep it off. See docs/login-protection-setup.md.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
